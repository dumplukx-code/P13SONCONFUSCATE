local function performSearch(target)
    local manualPath = manualPathBox.Text
    if manualPath ~= "" then
        local pathParts = {}
        for part in manualPath:gsub("/", "."):gmatch("[^%.]+") do
            table.insert(pathParts, part)
        end
        
        local success, remote = pcall(function()
            local current = ReplicatedStorage
            for _, partName in ipairs(pathParts) do
                current = current:WaitForChild(partName, 2)
            end
            return current
        end)
        
        if success and remote then
            remoteStatusLabel.Text = " Manual Remote: " .. remote.Name
            remoteStatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            
            if remote:IsA("RemoteEvent") then
                remote:FireServer(target)
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(target)
            end
            return true
        end
    end
    
    if foundRemote then
        if foundRemote:IsA("RemoteEvent") then
            foundRemote:FireServer(target)
        elseif foundRemote:IsA("RemoteFunction") then
            foundRemote:InvokeServer(target)
        end
        return true
    end
    
    return false
end

